{
  "manifest_version": 3,
  "name": "LinkedIn Easy Apply AutoApply by Kendrashya Diwakar",
  "version": "2.1.0",
  "description": "Automatically applies to LinkedIn Easy Apply job postings.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "logo.svg",
    "32": "logo.svg",
    "48": "logo.svg",
    "128": "logo.svg"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["profile.config.js", "controlPanel.js", "content.js"]
    }
  ],
  "options_page": "questions.html"
}
